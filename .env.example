VITE_APP_NAME=RODO

# Two public backend origins (NOT passwords or secret API keys).
# Production is the default whenever development is not configured.
VITE_API_BASE_URL=https://prod.octoserv-comp.com
# Enter the real HTTPS staging/dev API origin to activate runtime switching.
VITE_DEV_API_BASE_URL=

# Keep true for UI-only mode with mock data.
# Set false to connect with real backend endpoints.
VITE_ENABLE_MOCK_API=false

# Monitored contact inbox for public privacy/support/deletion pages. Required for store release.
VITE_SUPPORT_EMAIL=

# Google Maps browser key for Dashboard location picking. This is a public, website-restricted key.
# Enable Maps JavaScript API + Geocoding API in Google Cloud.
# Restrict key to Websites and add actual production/preview domains + local dev origins.
# NEVER reuse Android/iOS native keys or put an unrestricted key in VITE_.
# The existing Vercel variable name works without VITE_. Vite explicitly injects this one key.
GOOGLE_MAPS_BROWSER_API_KEY=
# Legacy name is also supported; GOOGLE_MAPS_BROWSER_API_KEY takes precedence.
# VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# RODO dashboard browser push (Firebase project: wasel-prod).
# Firebase web config is public and committed in src/features/push/browser-push.ts.
# IMPORTANT: apiKey is NOT the Web Push VAPID key.
# In Firebase console > Project settings > Cloud Messaging > Web Push certificates:
# copy the PUBLIC key here. Never put a server key/service-account JSON in Vite.
VITE_FIREBASE_VAPID_KEY=

# Authenticated FCM device-binding endpoints implemented by your backend.
# Set these ONLY after matching POST and DELETE handlers are deployed.
# Example API contract: POST/DELETE /api/Notifications/devices.
# They must bind/remove the token under the JWT's actual user ID.
VITE_FCM_DEVICE_REGISTER_PATH=
VITE_FCM_DEVICE_UNREGISTER_PATH=
